\documentclass[a4paper,10pt]{article}
\usepackage[left=1.2cm, top=1.2cm, right=1.2cm, bottom=1.2cm]{geometry}
\usepackage[sfdefault]{helvet}
\renewcommand{\familydefault}{\sfdefault}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{xcolor}
\usepackage{ragged2e}

\definecolor{headerblue}{RGB}{0, 60, 120}
\definecolor{labelgrey}{RGB}{75, 85, 99}
\definecolor{namegrey}{RGB}{85, 95, 110}

\pagestyle{empty}
\setlength{\parindent}{0pt}

% Section macro: black indicator bar on EVERY section with regular weight title
\newcommand{\cvsection}[1]{%
  \vspace{15pt}%
  \noindent{\rule[0.2ex]{1.3cm}{2.6pt}\hspace{0.35cm}\large #1}\par\vspace{6pt}%
}

% Skill Row matching HTML preview (3.8cm category width + ragged2e + hyphenpenalty=10000 prevents text collisions)
\newcommand{\skillrow}[2]{%
    \noindent
    \begin{minipage}[t]{3.8cm}
        \RaggedLeft \hyphenpenalty=10000 \small \textbf{#1}
    \end{minipage}%
    \hspace{0.4cm}%
    \begin{minipage}[t]{\dimexpr\linewidth-4.2cm\relax}
        \small #2
    \end{minipage}%
    \par\vspace{4.5pt}%
}

% General Bullet Lists
\setlist[itemize]{leftmargin=0.22in, label=\small\textbullet, nosep, topsep=2.5pt, itemsep=2.5pt, parsep=0pt, partopsep=0pt}

\begin{document}

% --- HEADER (2-Column Split matching HTML Preview) ---
\noindent
\begin{minipage}[t]{0.58\textwidth}
    \raggedright
    {\fontsize{20pt}{23pt}\selectfont\color{namegrey}\uppercase{<< static_profile.fullname >>}} \\[5pt]
    <BLOCK> if job.role </BLOCK>
    {\fontsize{10.5pt}{13pt}\selectfont \textit{<< job.role >>}}
    <BLOCK> endif </BLOCK>
\end{minipage}%
\hfill
\begin{minipage}[t]{0.40\textwidth}
    \raggedleft \small \itshape \color{labelgrey}
    <BLOCK> if static_profile.location </BLOCK><< static_profile.location >> \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.phone </BLOCK><< static_profile.phone >> \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.email and static_profile.email.text </BLOCK>\href{<< static_profile.email.href >>}{\textcolor{black}{\textbf{<< static_profile.email.text >>}}} \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.linkedin and static_profile.linkedin.href </BLOCK>\href{<< static_profile.linkedin.href >>}{linkedin.com} \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.github and static_profile.github.href </BLOCK>\href{<< static_profile.github.href >>}{github.com} \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.portfolio and static_profile.portfolio.href </BLOCK>\href{<< static_profile.portfolio.href >>}{<< static_profile.portfolio.href | clean_domain('portfolio') >>} \\ <BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.extra_links </BLOCK>
      <BLOCK> for el in static_profile.extra_links </BLOCK>
        \href{<< el.href >>}{<< el.href | clean_domain(el.text) >>}<BLOCK> if not loop.last </BLOCK> \\ <BLOCK> endif </BLOCK>
      <BLOCK> endfor </BLOCK>
    <BLOCK> endif </BLOCK>
\end{minipage}

\vspace{20pt}

% --- PROFESSIONAL SUMMARY ---
<BLOCK> if job.professional_summary </BLOCK>
\cvsection{Professional Summary}
{\small << job.professional_summary >>}\par\vspace{3pt}
<BLOCK> endif </BLOCK>

% --- TECHNICAL SKILLS ---
<BLOCK> if job.skills </BLOCK>
\cvsection{Technical Skills}
<BLOCK> for skill in job.skills </BLOCK>
\skillrow{<< skill.category >>}{<BLOCK> for val in skill.values </BLOCK><< val.name >><BLOCK> if not loop.last </BLOCK>, <BLOCK> endif </BLOCK><BLOCK> endfor </BLOCK>}
<BLOCK> endfor </BLOCK>
\vspace{2pt}
<BLOCK> endif </BLOCK>

% --- EXPERIENCE ---
<BLOCK> if job.experience </BLOCK>
\cvsection{Experience}
<BLOCK> for exp in job.experience </BLOCK>
\noindent\textbf{<< exp.title >>} \ $|$ \ \textit{<< exp.company >><BLOCK> if exp.location </BLOCK> -- << exp.location >><BLOCK> endif </BLOCK>} \hfill \small\color{labelgrey}<< exp.date >>\color{black}
\begin{itemize} \small
    <BLOCK> for point in exp.points </BLOCK>
    \item << point >>
    <BLOCK> endfor </BLOCK>
\end{itemize}
\vspace{8pt}
<BLOCK> endfor </BLOCK>
<BLOCK> endif </BLOCK>

% --- PROJECTS ---
<BLOCK> if job.projects </BLOCK>
\cvsection{Projects}
<BLOCK> for project in job.projects </BLOCK>
\noindent\textbf{<< project.name >>}<BLOCK> if project.project_line </BLOCK> \ / \ \textit{<< project.project_line >>}<BLOCK> endif </BLOCK> \hfill <BLOCK> if project.href </BLOCK>\href{<< project.href >>}{\small\color{labelgrey}\underline{<< project.href | clean_domain(project.href_name if project.href_name else 'demo') >>}}\color{black}<BLOCK> endif </BLOCK>
\begin{itemize} \small
    <BLOCK> for point in project.points </BLOCK>
    \item << point >>
    <BLOCK> endfor </BLOCK>
\end{itemize}
\vspace{11pt}
<BLOCK> endfor </BLOCK>
<BLOCK> endif </BLOCK>

% --- EDUCATION ---
<BLOCK> if static_profile.education </BLOCK>
\cvsection{Education}
<BLOCK> for edu in static_profile.education </BLOCK>
\noindent\textbf{<< edu.degree >>} \hfill \small\color{labelgrey}<< edu.date >>\color{black} \\
\small\color{labelgrey}<< edu.institution >><BLOCK> if edu.location </BLOCK> \ $|$ \ << edu.location >><BLOCK> endif </BLOCK><BLOCK> if edu.grade </BLOCK> \ $|$ \ Grade: << edu.grade >><BLOCK> endif </BLOCK>\color{black}
\vspace{8pt}
<BLOCK> endfor </BLOCK>
<BLOCK> endif </BLOCK>

% --- CERTIFICATIONS ---
<BLOCK> if static_profile.certifications </BLOCK>
\cvsection{Certifications}
<BLOCK> for cert in static_profile.certifications </BLOCK>
\noindent\textbf{<< cert.name >>} <BLOCK> if cert.link </BLOCK>\hfill \href{<< cert.link >>}{\small\color{labelgrey}\underline{[Verify Badge]}}\color{black}<BLOCK> endif </BLOCK> \\
\vspace{5pt}
<BLOCK> endfor </BLOCK>
<BLOCK> endif </BLOCK>

% --- ACHIEVEMENTS ---
<BLOCK> if job.achievements </BLOCK>
\cvsection{Achievements}
<BLOCK> for ach in job.achievements </BLOCK>
\noindent\textbf{<< ach.name >>}: \small << ach.description >> \\
\vspace{4pt}
<BLOCK> endfor </BLOCK>
<BLOCK> endif </BLOCK>

\end{document}
