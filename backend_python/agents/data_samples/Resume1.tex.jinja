\documentclass[a4paper,10pt]{article}
\usepackage[left=0.8cm,top=0.9cm,right=0.8cm,bottom=0.9cm,nohead,nofoot]{geometry}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{mathpazo} % Palatino Font
\usepackage{xcolor}
\usepackage{fontawesome5}
\usepackage{enumitem}
\usepackage{calc}
\usepackage[hidelinks]{hyperref}
\usepackage{paracol}

% --- COLORS ---
\definecolor{mainred}{RGB}{185, 0, 0}
\definecolor{headergray}{RGB}{60, 60, 60}

% --- GLOBAL SPACING ---
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedright

% --- COMMANDS ---

% Compact Section Header with non-colliding rule
\newcommand{\resumesection}[1]{%
    \vspace{10pt}%
    {\large \textsc{\textbf{#1}}}\par\vspace{3pt}%
    {\color{mainred}\rule{2cm}{2pt}}\par\vspace{6pt}%
}

% Compact Skill Bar
\newcommand{\skill}[3]{%
    \noindent
    \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
        \textbf{\small #1} & {\footnotesize #2} \\
    \end{tabular*}%
    \\[-3pt]%
    {\color{mainred}\rule{#3\linewidth}{3pt}}\par\vspace{4.5pt}%
}

% Compact Job Header
\newcommand{\jobheader}[3]{%
    \noindent
    {\textbf{#1}} \\
    {\small \textit{#2}} \hfill 
    \colorbox{mainred}{\makebox[2.5cm][c]{\color{white}\bfseries\footnotesize #3}}%
    \par\vspace{2pt}%
}

\begin{document}

% ====================================================================
% TWO COLUMN LAYOUT
% ====================================================================
\columnratio{0.30}
\begin{paracol}{2}

    % --- LEFT COLUMN ---
    \vspace{0pt} 

    % --- SKILLS ---
    \resumesection{SKILLS}
    
    <BLOCK> set count = namespace(value=0) </BLOCK>
    <BLOCK> for skill in job.skills </BLOCK>
    <BLOCK> for val in skill.values </BLOCK>
    <BLOCK> if count.value < 15 </BLOCK>
    \skill{<< val.name >>}{<< val.level >>}{<< val.score >>}
    <BLOCK> set count.value = count.value + 1 </BLOCK>
    <BLOCK> endif </BLOCK>
    <BLOCK> endfor </BLOCK>
    <BLOCK> endfor </BLOCK>

    \vspace{0.7cm}

    % --- CONTACT ---
    \resumesection{CONTACT}
    \small
    <BLOCK> if static_profile.location </BLOCK>{\color{gray}<< static_profile.location >>}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.phone </BLOCK>{\color{gray}<< static_profile.phone >>}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.email and static_profile.email.text </BLOCK>\href{<< static_profile.email.href >>}{\color{mainred}<< static_profile.email.text >>}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.linkedin and static_profile.linkedin.href </BLOCK>\href{<< static_profile.linkedin.href >>}{\color{mainred}LinkedIn}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.github and static_profile.github.href </BLOCK>\href{<< static_profile.github.href >>}{\color{mainred}GitHub}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.portfolio and static_profile.portfolio.href </BLOCK>\href{<< static_profile.portfolio.href >>}{\color{mainred}Portfolio}\par\vspace{2.5pt}<BLOCK> endif </BLOCK>
    <BLOCK> if static_profile.extra_links </BLOCK>
    <BLOCK> for el in static_profile.extra_links </BLOCK>
    \href{<< el.href >>}{\color{mainred}<< el.text >>}\par\vspace{2.5pt}
    <BLOCK> endfor </BLOCK>
    <BLOCK> endif </BLOCK>

    \vspace{0.7cm}

    % --- EDUCATION ---
    <BLOCK> if static_profile.education </BLOCK>
    \resumesection{EDUCATION}
    <BLOCK> for edu in static_profile.education </BLOCK>
    \noindent\textbf{\small << edu.degree >>} \\
    {\footnotesize\color{gray}<< edu.institution >>} \\
    {\scriptsize\color{gray}<< edu.date >><BLOCK> if edu.grade </BLOCK> \ $|$ \ << edu.grade >><BLOCK> endif </BLOCK>}
    \vspace{6pt}
    <BLOCK> endfor </BLOCK>
    <BLOCK> endif </BLOCK>

    \switchcolumn
    % --- RIGHT COLUMN ---
    \vspace{0pt} 

    % --- HEADER BOX ---
    \noindent
    \colorbox{headergray}{
        \begin{minipage}[c][3.0cm][c]{\dimexpr\linewidth-2\fboxsep}
            \centering
            \color{white}
            {\huge \textsc{<< static_profile.fullname >>}} \\ [6pt]
            {\rule{0.5\linewidth}{0.5pt}} \\ [6pt]
            {\large << job.role >>}
        \end{minipage}
    }
    
    \vspace{10pt}

    % --- PROFILE ---
    <BLOCK> if job.professional_summary </BLOCK>
    \resumesection{PROFILE}
    \small
    << job.professional_summary >>
    \vspace{6pt}
    <BLOCK> endif </BLOCK>

    % --- WORK EXPERIENCE / KEY PROJECTS ---
    <BLOCK> if job.experience </BLOCK>
    \resumesection{WORK EXPERIENCE}
    <BLOCK> for exp in job.experience </BLOCK>
    \jobheader{<< exp.title >>}{<< exp.company >> <BLOCK> if exp.location </BLOCK> - << exp.location >><BLOCK> endif </BLOCK>}{<< exp.date >>}
    \begin{itemize}[leftmargin=*, label=\small\textbullet, nosep, topsep=1.5pt, itemsep=2pt] \small
        <BLOCK> for point in exp.points </BLOCK>
        \item << point >>
        <BLOCK> endfor </BLOCK>
    \end{itemize}
    \vspace{8pt}
    <BLOCK> endfor </BLOCK>
    <BLOCK> endif </BLOCK>

    <BLOCK> if job.projects </BLOCK>
    \resumesection{KEY PROJECTS}
    <BLOCK> for project in job.projects </BLOCK>
    \noindent\textbf{<< project.name >>}<BLOCK> if project.project_line </BLOCK> \ $|$ \ \textit{\small << project.project_line >>}<BLOCK> endif </BLOCK> \hfill <BLOCK> if project.href </BLOCK>\href{<< project.href >>}{\small\color{mainred}\underline{<< project.href | clean_domain(project.href_name if project.href_name else 'Link') >>}}\color{black}<BLOCK> endif </BLOCK>
    \begin{itemize}[leftmargin=*, label=\small\textbullet, nosep, topsep=1.5pt, itemsep=2pt] \small
        <BLOCK> for point in project.points </BLOCK>
        \item << point >>
        <BLOCK> endfor </BLOCK>
    \end{itemize}
    \vspace{8pt}
    <BLOCK> endfor </BLOCK>
    <BLOCK> endif </BLOCK>

    % --- CERTIFICATIONS ---
    <BLOCK> if static_profile.certifications </BLOCK>
    \resumesection{CERTIFICATIONS}
    \begin{itemize}[leftmargin=*, label=\small\textbullet, nosep, topsep=1.5pt, itemsep=1.5pt] \small
        <BLOCK> for cert in static_profile.certifications </BLOCK>
        \item \textbf{<< cert.name >>}<BLOCK> if cert.link </BLOCK> \hfill \href{<< cert.link >>}{\small\color{mainred}\underline{[Verify Badge]}}\color{black}<BLOCK> endif </BLOCK>
        <BLOCK> endfor </BLOCK>
    \end{itemize}
    \vspace{6pt}
    <BLOCK> endif </BLOCK>

    % --- ACHIEVEMENTS ---
    <BLOCK> if job.achievements </BLOCK>
    \resumesection{ACHIEVEMENTS}
    \begin{itemize}[leftmargin=*, label=\small\textbullet, nosep, topsep=1.5pt, itemsep=1.5pt] \small
        <BLOCK> for ach in job.achievements </BLOCK>
        \item \textbf{<<ach.name>>}: <<ach.description>>
        <BLOCK> endfor </BLOCK>
    \end{itemize}
    <BLOCK> endif </BLOCK>

\end{paracol}

\end{document}
